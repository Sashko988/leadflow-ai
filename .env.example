# Required for AI analysis/reply generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Business identity used in generated replies
BUSINESS_NAME=Your Business Name
SENDER_NAME=Your Name

# Runtime safety defaults
DATABASE_PATH=data/leads.db
GMAIL_QUERY=in:inbox subject:"New Website Lead" -from:me
MAX_EMAILS_PER_RUN=20
DRY_RUN=true
TEST_EMAIL=

# Web MVP
WEB_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
CONTACT_EMAIL=hello@yourbusiness.com
ADMIN_PASSWORD=change-this-password
HOST=127.0.0.1
PORT=8000
