# Required for AI analysis/reply generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Business identity used in generated replies
BUSINESS_NAME=Your Business Name
SENDER_NAME=Your Name

# Runtime safety defaults
DATABASE_PATH=data/leads.db
GMAIL_QUERY=in:inbox subject:"New Website Lead" -from:me
MAX_EMAILS_PER_RUN=20
DRY_RUN=true
TEST_EMAIL=

# Web MVP
WEB_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
CONTACT_EMAIL=hello@yourbusiness.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@yourbusiness.com
SMTP_PASSWORD=use-an-app-password
ADMIN_PASSWORD=change-this-password

# Social sign-in (optional; create OAuth apps in Google Cloud and Microsoft Entra)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
HOST=127.0.0.1
PORT=8000
